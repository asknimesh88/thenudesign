---
import type { Locale } from '../site.config';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Gallery from '../components/Gallery.astro';
import { ROUTES } from '../i18n/routes';
import { PAGES } from '../i18n/pages';
import { CONTENT } from '../i18n/content';
import { UI } from '../i18n/ui';
import { collection, large, CREDITS, MAKEUP, type Collection } from '../data/photos';
import { abs, gallerySchema } from '../lib/schema';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = PAGES.portfolio[locale];
const c = CONTENT[locale];
const ui = UI[locale];
const order: Collection[] = ['collection-2026', 'summer-2025'];
const url = abs(ROUTES.portfolio[locale]);

const schema = await Promise.all(
  order.map(async (id) => {
    const images = await Promise.all(
      collection(id).map(async (p) => {
        const img = await large(p);
        return {
          url: img.src,
          caption: p.alt[locale],
          width: Number(img.attributes.width),
          height: Number(img.attributes.height),
        };
      }),
    );
    return gallerySchema({
      id: `${url}#${id}`,
      name: c.portfolio.collections[id].heading,
      description: c.portfolio.collections[id].text,
      images,
      photographer: CREDITS[id] && {
        name: CREDITS[id]!.name,
        sameAs: [CREDITS[id]!.instagram, CREDITS[id]!.facebook].filter((u): u is string => !!u),
      },
      makeupArtist: MAKEUP[id]?.name,
    });
  }),
);
---

<Base locale={locale} route="portfolio" image="thenu-design-2026-collection-group" schema={schema}>
  <PageHead locale={locale} eyebrow={page.eyebrow} title={page.h1} intro={page.intro} photos={['thenu-design-2026-collection-group', 'thenu-design-floral-dress-blue-tulle-skirt-lupins']} />

  {
    order.map((id, i) => (
      <section class:list={['section', { 'section-dark': i === 0 }]} id={id}>
        <div class="container">
          <header class="section-head">
            <h2>{c.portfolio.collections[id].heading}</h2>
            <p class="lead">{c.portfolio.collections[id].text}</p>
            {
              CREDITS[id] && (
                <p class="credit">
                  <span class="credit-label">{ui.photography}</span>
                  <span class="credit-name">{CREDITS[id]!.name}</span>
                  {CREDITS[id]!.instagram && (
                    <a href={CREDITS[id]!.instagram} target="_blank" rel="noopener">
                      Instagram {CREDITS[id]!.instagramHandle}
                    </a>
                  )}
                  {CREDITS[id]!.facebook && (
                    <a href={CREDITS[id]!.facebook} target="_blank" rel="noopener">
                      Facebook {CREDITS[id]!.facebookName}
                    </a>
                  )}
                </p>
              )
            }
            {
              MAKEUP[id] && (
                <p class="credit">
                  <span class="credit-label">{ui.makeup}</span>
                  <span class="credit-name">{MAKEUP[id]!.name}</span>
                </p>
              )
            }
          </header>
          <Gallery photos={collection(id)} locale={locale} />
        </div>
      </section>
    ))
  }

  <section class="cta-band">
    <div class="container narrow center">
      <h2>{c.portfolio.ctaHeading}</h2>
      <p class="lead">{c.portfolio.ctaText}</p>
      <div class="actions center">
        <a class="button" href={ROUTES.contact[locale]}>{ui.getInTouch}</a>
        <a class="link-arrow" href={ROUTES.services[locale]}>{ui.allServices}</a>
      </div>
    </div>
  </section>
</Base>
