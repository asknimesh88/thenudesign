---
import { SITE, type Locale } from '../site.config';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import CtaBand from '../components/CtaBand.astro';
import { ROUTES } from '../i18n/routes';
import { PAGES } from '../i18n/pages';
import { CONTENT } from '../i18n/content';
import { UI } from '../i18n/ui';
import { CREDITS } from '../data/photos';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = PAGES.home[locale];
const c = CONTENT[locale];
const col = c.collection;
const ui = UI[locale];
const credit = CREDITS['evening-2026'];
const collectionUrl = `${ROUTES.portfolio[locale]}#evening-2026`;
---

<Base locale={locale} route="home">
  <!-- Evening wear 2026 showcase -->
  <section class="showcase">
    <div class="container showcase-grid">
      <div class="showcase-text">
        <p class="eyebrow">{page.eyebrow}</p>
        <h1>
          {page.h1}
          <span class="h1-by">{ui.byThenu}</span>
        </h1>
        <p class="lead">{page.intro}</p>
        <div class="actions">
          <a class="button button-light" href={collectionUrl}>{col.viewCollection}</a>
          <a class="link-arrow" href={ROUTES.contact[locale]}>{col.bookConsultation}</a>
        </div>
        {
          credit && (
            <p class="showcase-credit">
              {ui.photography}: <a href={credit.instagram} target="_blank" rel="noopener">{credit.name}</a>
            </p>
          )
        }
      </div>
      <div class="showcase-media">
        <Photo
          class="showcase-main"
          name="thenu-design-red-organza-gown-puff-sleeves-portrait"
          locale={locale}
          width={620}
          sizes="(min-width: 900px) 34vw, 62vw"
          priority
        />
        <Photo
          class="showcase-side"
          name="thenu-design-teal-halter-gown-front-slit"
          locale={locale}
          width={300}
          sizes="(min-width: 900px) 17vw, 30vw"
          priority
        />
        <Photo
          class="showcase-side"
          name="thenu-design-cobalt-blue-strapless-gown-floral-applique"
          locale={locale}
          width={300}
          sizes="(min-width: 900px) 17vw, 30vw"
        />
      </div>
    </div>
  </section>

  <!-- Lookbook -->
  <section class="lookbook" aria-labelledby="lookbook-heading">
    <div class="container lookbook-head">
      <h2 id="lookbook-heading">{col.lookbookHeading}</h2>
      <div class="lookbook-controls">
        <button type="button" class="lookbook-prev" aria-label={ui.previous}>←</button>
        <button type="button" class="lookbook-next" aria-label={ui.next}>→</button>
        <a class="link-arrow" href={collectionUrl}>{col.allPhotos}</a>
      </div>
    </div>
    <ol class="lookbook-track" role="list">
      {
        col.looks.map((name) => (
          <li>
            <a href={collectionUrl}>
              <Photo name={name} locale={locale} width={440} sizes="(min-width: 900px) 26vw, 72vw" />
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Collection story -->
  <section class="story-banner">
    <Photo
      class="story-img"
      name="thenu-design-evening-wear-collection-group-back-view"
      locale={locale}
      width={1920}
      sizes="100vw"
    />
    <div class="story-card">
      <p class="eyebrow">{col.heading}</p>
      <h2>{col.storyHeading}</h2>
      {col.story.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <!-- Made to measure -->
  <section class="section section-dark">
    <div class="container split">
      <div class="split-media">
        <Photo name="thenu-design-teal-and-red-organza-gowns-duo" locale={locale} width={640} sizes="(min-width: 900px) 40vw, 92vw" />
      </div>
      <div class="split-text">
        <h2>{col.madeToMeasureHeading}</h2>
        <p class="lead">{col.madeToMeasure}</p>
        <div class="actions">
          <a class="button button-light" href={ROUTES.contact[locale]}>{ui.getInTouch}</a>
          <a class="link-arrow" href={`${ROUTES.services[locale]}#${c.services[0].id}`}>{col.customDresses}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- About Thenu -->
  <section class="section">
    <div class="container split">
      <div class="split-media">
        <Photo name="thenu-fashion-designer-tampere-portrait" class="pos-top" locale={locale} width={640} sizes="(min-width: 900px) 40vw, 92vw" />
      </div>
      <div class="split-text">
        <h2>{c.welcome.heading}</h2>
        {c.welcome.body.map((p) => <p>{p}</p>)}
        <p class="signature">{c.welcome.signature}</p>
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="container">
      <header class="section-head">
        <h2>{c.servicesHeading}</h2>
        <p class="lead">{c.servicesLead}</p>
      </header>
      <ol class="cards" role="list">
        {
          c.services.map((s, i) => (
            <li class="card">
              <a href={`${ROUTES.services[locale]}#${s.id}`}>
                <Photo name={s.photo} locale={locale} width={480} sizes="(min-width: 1100px) 260px, (min-width: 700px) 45vw, 92vw" />
                <span class="card-num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{s.title}</h3>
                <p>{s.short}</p>
                <span class="link-arrow">{ui.learnMore}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="center">{c.valuesHeading}</h2>
      <ol class="values" role="list">
        {
          c.values.map((v) => (
            <li>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="banner">
    <Photo name="thenu-design-floral-dress-lupin-field-tampere" locale={locale} width={1920} sizes="100vw" class="banner-img" />
    <div class="banner-card">
      <h2>{c.mission.heading}</h2>
      <p>{c.mission.text}</p>
    </div>
  </section>

  <section class="section">
    <div class="container split split-reverse">
      <div class="split-media">
        <Photo name="thenu-design-lilac-floral-ruffle-mini-dress" locale={locale} width={640} sizes="(min-width: 900px) 40vw, 92vw" />
      </div>
      <div class="split-text">
        <h2>{c.local.heading}</h2>
        <p>{c.local.text}</p>
        <p>
          <a class="link-arrow" href={SITE.social.instagram} target="_blank" rel="noopener">
            {ui.followInstagram} {SITE.instagramHandle}
          </a>
        </p>
      </div>
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>

<script>
  // Lookbook arrow buttons scroll the track by roughly one card.
  const track = document.querySelector<HTMLElement>('.lookbook-track');
  const step = () => (track?.querySelector('li')?.getBoundingClientRect().width ?? 300) + 16;
  document.querySelector('.lookbook-prev')?.addEventListener('click', () => track?.scrollBy({ left: -step(), behavior: 'smooth' }));
  document.querySelector('.lookbook-next')?.addEventListener('click', () => track?.scrollBy({ left: step(), behavior: 'smooth' }));
</script>
