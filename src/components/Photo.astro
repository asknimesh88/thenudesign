---
// Use this for every photo on the site. At build time each photo is encoded as
// AVIF and WebP at a fixed set of widths (shared across pages, so each size is
// only made once), plus a single JPEG fallback for very old browsers.
// `alt` comes from src/data/photos.ts in the page's language.
import { getImage } from 'astro:assets';
import type { Locale } from '../site.config';
import { photo, variant, WIDTHS } from '../data/photos';

interface Props {
  name: string;
  locale: Locale;
  /** Largest width this photo is displayed at (CSS px); sizes up to 2× are generated. */
  width?: number;
  sizes?: string;
  priority?: boolean;
  class?: string;
}

const { name, locale, width = 1200, sizes = '100vw', priority = false, class: className } = Astro.props;
const p = photo(name);
const need = Math.min(p.src.width, width * 2);
const widths = WIDTHS.filter((w) => w <= need);
if (!widths.length || (need === p.src.width && widths.at(-1)! < need)) widths.push(p.src.width);

const srcset = async (format: 'avif' | 'webp') =>
  (await Promise.all(widths.map((w) => variant(p, w, format)))).map((img, i) => `${img.src} ${widths[i]}w`).join(', ');

const fallbackWidth = widths.find((w) => w >= 800) ?? widths.at(-1)!;
const fallback = await getImage({ src: p.src, width: fallbackWidth, format: 'jpg', quality: 80 });
---

<picture class={className}>
  <source type="image/avif" srcset={await srcset('avif')} sizes={sizes} />
  <source type="image/webp" srcset={await srcset('webp')} sizes={sizes} />
  <img
    src={fallback.src}
    alt={p.alt[locale]}
    width={fallback.attributes.width}
    height={fallback.attributes.height}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
  />
</picture>
