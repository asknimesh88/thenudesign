---
import { SITE, type Locale } from '../site.config';
import { NAV, ROUTES, type RouteKey } from '../i18n/routes';
import { UI } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';

interface Props {
  locale: Locale;
  route?: RouteKey;
}

const { locale, route } = Astro.props;
const ui = UI[locale];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href={ROUTES.home[locale]} aria-label={`${SITE.brand} – ${ui.nav.home}`}>
      <span class="wordmark-name">{SITE.name}</span>
      <span class="wordmark-sub">Tikki ja Tyyli</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-toggle-bars" aria-hidden="true"></span>
      <span class="visually-hidden">{ui.menu}</span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label={ui.menu}>
      <ul class="nav">
        {
          NAV.filter((key) => key !== 'home').map((key) => (
            <li>
              <a href={ROUTES[key][locale]} aria-current={key === route ? 'page' : undefined}>
                {ui.nav[key]}
              </a>
            </li>
          ))
        }
      </ul>
      <LangSwitch locale={locale} route={route} />
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('menu-open', open);
  });
</script>
