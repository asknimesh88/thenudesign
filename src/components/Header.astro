---
import { SITE, type Locale } from '../site.config';
import { NAV, ROUTES, type RouteKey } from '../i18n/routes';
import { UI } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';

interface Props {
  locale: Locale;
  route?: RouteKey;
}

const { locale, route } = Astro.props;
const ui = UI[locale];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={ROUTES.home[locale]} aria-label={`${SITE.name} – ${ui.nav.home}`}>
      {SITE.name}
    </a>
    <nav aria-label={ui.menu}>
      <ul class="nav">
        {
          NAV.filter((key) => key !== 'home').map((key) => (
            <li>
              <a href={ROUTES[key][locale]} aria-current={key === route ? 'page' : undefined}>
                {ui.nav[key]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <LangSwitch locale={locale} route={route} />
  </div>
</header>
